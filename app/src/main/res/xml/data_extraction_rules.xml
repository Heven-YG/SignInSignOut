<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and transfer rules for Android 12 and higher.
   The cached profile and the installation ID stay on this device only.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="chatAppPreference.xml" />
        <exclude domain="sharedpref" path="chatAppInstallation.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="chatAppPreference.xml" />
        <exclude domain="sharedpref" path="chatAppInstallation.xml" />
    </device-transfer>
</data-extraction-rules>
