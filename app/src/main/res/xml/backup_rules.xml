<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android 11 and lower.
   The cached profile and the installation ID must not be restored onto another device:
   a restored installation ID would make two devices share one FCM device document.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="chatAppPreference.xml" />
    <exclude domain="sharedpref" path="chatAppInstallation.xml" />
</full-backup-content>
